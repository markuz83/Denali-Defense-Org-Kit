                <elementReference>fxFundedValue</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Contract_Value__c</field>
            <value>
                <elementReference>fxContractValue</elementReference>
            </value>
        </inputAssignments>
        <object>Contract</object>
    </recordUpdates>
