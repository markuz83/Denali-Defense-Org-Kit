    <description>Automation inventory #4. Fills blank Project and Supplier from the Deliverable, Submitted By from the portal user&apos;s Contact, and Submitted Date with now. Values already set (e.g. by the seed script) are kept.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxProject</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!$Record.Project__c}, {!$Record.Deliverable__r.Project__c})</expression>
    </formulas>
    <formulas>
        <name>fxSubmittedDate</name>
        <dataType>DateTime</dataType>
        <expression>BLANKVALUE({!$Record.Submitted_Date__c}, NOW())</expression>
    </formulas>
