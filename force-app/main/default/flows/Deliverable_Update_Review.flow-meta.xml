    <description>Automation inventory #6. On Accepted, pushes the update onto its Deliverable (percent complete, forecast date, status, customer action, blockers) and stamps Latest Update Date; Health stays PM-owned. On Needs Clarification or Rejected, emails the submitter the Reviewer Comments on the asynchronous path, so an email failure never blocks the review.</description>
    <environments>Default</environments>
    <formulas>
        <description>Stamps today when the supplier reports Complete and no completion date exists, which the Actual_Completion_Required validation rule needs.</description>
        <name>fxActualCompletionDate</name>
        <dataType>Date</dataType>
        <expression>IF(AND(ISPICKVAL({!$Record.Reported_Status__c}, &quot;Complete&quot;), ISBLANK({!Get_Deliverable.Actual_Completion_Date__c})), TODAY(), {!Get_Deliverable.Actual_Completion_Date__c})</expression>
    </formulas>
    <formulas>
        <name>fxForecastDate</name>
        <dataType>Date</dataType>
        <expression>BLANKVALUE({!$Record.Forecast_Completion_Date__c}, {!Get_Deliverable.Forecast_Completion_Date__c})</expression>
    </formulas>
    <formulas>
        <name>fxPercentComplete</name>
        <dataType>Number</dataType>
        <expression>BLANKVALUE({!$Record.Percent_Complete__c}, {!Get_Deliverable.Percent_Complete__c})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fxStatus</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK(TEXT({!$Record.Reported_Status__c})), TEXT({!Get_Deliverable.Status__c}), TEXT({!$Record.Reported_Status__c}))</expression>
    </formulas>
