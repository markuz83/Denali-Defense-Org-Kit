    <assignments>
        <name>Set_Manager_And_Key</name>
        <label>Set Manager And Key</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <assignmentItems>
            <assignToReference>$Record.Manager__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Employee__r.ManagerId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Unique_Key__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fxUniqueKey</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>Automation inventory #14. Manager comes from the Employee&apos;s User.ManagerId; Unique Key (Project Id + Employee Id) blocks assigning the same person to the same project twice.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxUniqueKey</name>
        <dataType>String</dataType>
        <expression>{!$Record.Project__c} &amp; {!$Record.Employee__c}</expression>
    </formulas>
    <interviewLabel>Project Resource Defaults {!$Flow.CurrentDateTime}</interviewLabel>
