            </connector>
            <label>Has Option Date</label>
        </rules>
    </decisions>
    <decisions>
        <name>Renewal_Already_Open</name>
        <label>Renewal Already Open?</label>
        <locationX>182</locationX>
        <locationY>450</locationY>
        <defaultConnector>
            <targetReference>Option_Date_Set</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>None Open</defaultConnectorLabel>
        <rules>
            <name>Already_Open</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Open_Contract_Opportunity</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Already Open</label>
        </rules>
    </decisions>
    <description>Automation inventory #13. 90 days before a Renewal milestone&apos;s Due Date (immediately if already inside that window), creates an Opportunity: Option Exercise when the Contract still has a Next Option Date, otherwise Recompete. Account and Contract come from the milestone, Amount from the Service Engagement&apos;s Annual Contract Value, Close Date from the Due Date, Stage from the org&apos;s first active open stage, and Owner from the Milestone Owner, then the Service Owner. Skips when an open Opportunity is already linked to the milestone&apos;s Contract, so a renewal isn&apos;t duplicated.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxOppName</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Record.Service_Engagement__r.Name} &amp; &quot; - &quot; &amp; {!varOppType}, 120)</expression>
    </formulas>
    <formulas>
        <name>fxOwnerId</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE(BLANKVALUE({!$Record.Milestone_Owner__c}, {!$Record.Service_Engagement__r.Service_Owner__c}), {!$Record.CreatedById})</expression>
    </formulas>
    <interviewLabel>Engagement Milestone Renewal Opp {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Engagement Milestone Renewal Opp</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
