        </connector>
    </assignments>
    <decisions>
        <name>Contract_Has_Option</name>
        <label>Contract Has Option?</label>
        <locationX>314</locationX>
        <locationY>400</locationY>
        <defaultConnector>
            <targetReference>Get_First_Open_Stage</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Recompete</defaultConnectorLabel>
        <rules>
            <name>Option_Remaining</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Contract__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Open_Contract_Opportunity</targetReference>
            </connector>
            <label>Has Contract</label>
        </rules>
    </decisions>
    <decisions>
        <name>Option_Date_Set</name>
        <label>Option Date Set?</label>
        <locationX>182</locationX>
        <locationY>500</locationY>
        <defaultConnector>
            <targetReference>Get_First_Open_Stage</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Option Left</defaultConnectorLabel>
        <rules>
            <name>Has_Option_Date</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Contract__r.Next_Option_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
