<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>creator</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Account</field>
        <field>Amount</field>
        <field>Contract_Type__c</field>
        <field>Estimated_Margin__c</field>
        <field>Margin_Floor__c</field>
        <field>Margin_Shortfall__c</field>
        <field>Pricing_Rationale__c</field>
        <field>Incumbent__c</field>
        <field>Acquisition_Type__c</field>
        <field>CloseDate</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <type>adhoc</type>
            </approver>
        </assignedApprover>
        <description>The submitter routes the deal to the pricing reviewer, who decides whether the below-floor price is worth it (strategic entry, competitive must-win) or must be re-priced. Manually chosen because Opportunities can&apos;t be queue-owned, so an approval step can&apos;t target a queue.</description>
        <label>Pricing Review</label>
        <name>Pricing_Review</name>
    </approvalStep>
    <description>Opportunities with Estimated Margin below the Margin Floor for their contract type (Cost Plus 7%, T&amp;M 10%, Fixed Price 12%) need Pricing Review approval before proposal or Closed Won (enforced by the Margin_Approval_Required validation rule).</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Opportunity.Below_Margin_Floor__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Margin_Approval_Approved</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Margin_Approval_Rejected</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Margin_Approval_Pending</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Margin Exception</label>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>Margin_Approval_Clear</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
