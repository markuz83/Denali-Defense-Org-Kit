<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Mitigation_Plan_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(OR(Severity__c = "High", Severity__c = "Critical"), ISBLANK(Mitigation_Plan__c))</errorConditionFormula>
    <errorDisplayField>Mitigation_Plan__c</errorDisplayField>
    <errorMessage>High and Critical risks need a Mitigation Plan.</errorMessage>
</ValidationRule>
