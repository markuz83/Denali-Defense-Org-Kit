<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Blocker_Description_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Status__c, "Blocked"), ISBLANK(Blocker_Description__c))</errorConditionFormula>
    <errorDisplayField>Blocker_Description__c</errorDisplayField>
    <errorMessage>Describe the blocker when Status is Blocked.</errorMessage>
</ValidationRule>
