<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Actual_Completion_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Status__c, "Complete"), ISBLANK(Actual_Completion_Date__c))</errorConditionFormula>
    <errorDisplayField>Actual_Completion_Date__c</errorDisplayField>
    <errorMessage>Enter the Actual Completion Date when the deliverable is Complete.</errorMessage>
</ValidationRule>
