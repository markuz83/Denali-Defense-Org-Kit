<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Resolution_Summary_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Status, "Closed"), ISBLANK(Resolution_Summary__c))</errorConditionFormula>
    <errorDisplayField>Resolution_Summary__c</errorDisplayField>
    <errorMessage>Enter a Resolution Summary before closing the case.</errorMessage>
</ValidationRule>
