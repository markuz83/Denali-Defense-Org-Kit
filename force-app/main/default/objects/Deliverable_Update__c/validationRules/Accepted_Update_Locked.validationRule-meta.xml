<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Accepted_Update_Locked</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISNEW()), ISPICKVAL(PRIORVALUE(Internal_Review_Status__c), "Accepted"))</errorConditionFormula>
    <errorMessage>Accepted updates can't be edited.</errorMessage>
</ValidationRule>
