<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Draft_Pricing_Rationale</name>
        <label>Draft Pricing Rationale</label>
        <locationX>50</locationX>
        <locationY>276</locationY>
        <actionName>Pricing_Rationale</actionName>
        <actionType>generatePromptResponse</actionType>
        <connector>
            <targetReference>Save_Rationale</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>Input:Opportunity</name>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </inputParameters>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>64.0</apiVersion>
    <description>When an Opportunity is priced below its Margin Floor, has Einstein draft a Pricing Rationale (Pricing Rationale prompt template) for the Margin Exception approver. Runs on the asynchronous path so the save isn&apos;t held up by the model call, and before submission, so the record isn&apos;t approval-locked yet. Fires when an open deal crosses below the floor (created below it, or edited from at/above to below); further changes while already below don&apos;t redraft.</description>
    <environments>Default</environments>
    <interviewLabel>Opportunity Pricing Rationale {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Pricing Rationale</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Save_Rationale</name>
        <label>Save Rationale</label>
        <locationX>50</locationX>
        <locationY>384</locationY>
        <inputAssignments>
            <field>Pricing_Rationale__c</field>
            <value>
                <elementReference>Draft_Pricing_Rationale.promptResponse</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Below_Margin_Floor__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Draft_Pricing_Rationale</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
